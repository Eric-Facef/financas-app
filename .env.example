# Copie para .env e ajuste. Sem aspas e sem espaços ao redor do "=".
# Em produção (Render) cadastre estas variáveis no painel, não em arquivo.

# --- local (docker compose usa a porta 5433) ---
DATABASE_URL=jdbc:postgresql://localhost:5433/financas
DB_USER=financas
DB_PASSWORD=financas
JWT_SECRET=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres

# --- produção (Render + Neon) ---
# SPRING_PROFILES_ACTIVE=prod
# DATABASE_URL=jdbc:postgresql://<host-com-pooler>/<banco>?sslmode=require
# FLYWAY_URL=jdbc:postgresql://<host-direto-sem-pooler>/<banco>?sslmode=require
# DB_USER=
# DB_PASSWORD=
# DB_POOL_SIZE=3
# PASSKEY_RP_ID=<seu-servico>.onrender.com   # domínio do site, sem https:// e sem porta (login por digital)
# ALLOWED_ORIGINS=https://<seu-servico>.onrender.com
# COOKIE_SECURE=true
# COOKIE_SAMESITE=Lax
