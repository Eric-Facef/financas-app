# Copie para .env (local) ou cadastre no painel do Render (produção)
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres

# Neon: use a URL JDBC (jdbc:postgresql://...), não a postgres://
DATABASE_URL=jdbc:postgresql://localhost:5432/financas
DB_USER=financas
DB_PASSWORD=financas

# Neon: conexão DIRETA (sem -pooler) para o Flyway rodar migrations
# FLYWAY_URL=jdbc:postgresql://ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Front-end(s) autorizados (CORS + checagem de Origin no refresh/logout)
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173

# Produção com front em outro domínio: COOKIE_SECURE=true e COOKIE_SAMESITE=None
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
